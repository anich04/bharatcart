# =============================================================================
# BharatCart — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Anything WITHOUT the NEXT_PUBLIC_ prefix is SERVER-ONLY and must never reach
# the browser. Only NEXT_PUBLIC_* vars are exposed to client code.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase Postgres)
# DATABASE_URL  = pooled connection (PgBouncer, port 6543) used by the app.
# DIRECT_URL    = direct connection (port 5432) used ONLY by Prisma Migrate.
# Get both from: Supabase Dashboard -> Project -> Connect -> ORMs / Prisma.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -base64 32`.
# AUTH_URL: only needed for non-Vercel / custom domains; optional on Vercel.
# Google OAuth: create credentials at https://console.cloud.google.com
#   Authorized redirect URI: {APP_URL}/api/auth/callback/google
# -----------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Razorpay (payments) — TEST MODE keys until the full flow is verified.
# KEY_SECRET and WEBHOOK_SECRET are SERVER-ONLY. Only the public key id may
# reach the browser (NEXT_PUBLIC_RAZORPAY_KEY_ID). Get keys from the Razorpay
# Dashboard -> Settings -> API Keys (toggle Test/Live). Webhook secret is set
# when you create the webhook (Dashboard -> Settings -> Webhooks).
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Cloudinary (product & review images)
# API_SECRET is SERVER-ONLY (used to sign uploads). Cloud name is public.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="bharatcart"

# -----------------------------------------------------------------------------
# Email (Resend) — transactional email (order confirmation, shipping, reset).
# EMAIL_FROM must be a verified sender/domain in Resend.
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="BharatCart <orders@example.com>"

# -----------------------------------------------------------------------------
# Rate limiting (Upstash Redis) — login, signup, password reset, reviews,
# coupon application. Create a free Redis DB at https://upstash.com
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# Business configuration (single-vendor store)
# Money values are in PAISE (₹1 = 100). GST fields drive invoice generation.
# SELLER_STATE is the place-of-supply ORIGIN: intra-state => CGST+SGST,
# inter-state => IGST.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="BharatCart"
SELLER_LEGAL_NAME="BharatCart Retail Pvt Ltd"
SELLER_GSTIN="29ABCDE1234F1Z5"          # dummy — replace with real GSTIN
SELLER_STATE="Karnataka"                # place-of-supply origin
SELLER_STATE_CODE="29"                  # GST state code for Karnataka

COD_MAX_ORDER_VALUE_PAISE="500000"      # ₹5,000 COD cap
FREE_SHIPPING_THRESHOLD_PAISE="49900"   # free shipping over ₹499
SHIPPING_FLAT_PAISE="4900"              # ₹49 flat shipping below threshold
COD_SURCHARGE_PAISE="3000"              # ₹30 COD handling fee
