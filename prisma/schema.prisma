// BharatCart — Prisma schema (Phase 0, for review)
// Conventions:
//  - ALL money is stored as INTEGER PAISE (₹1 = 100). Never a float for currency.
//  - Prices are GST-INCLUSIVE (Indian MRP law). Tax is DERIVED, not added at checkout.
//  - gstRate is an enum of the real slabs; tax amounts are snapshotted per order line.
//  - Every buyable unit is a ProductVariant — even a "simple" product has exactly one
//    default variant. Cart/Order/stock always reference a variant, so the logic is uniform.
//  - IDs are cuid(). Timestamps on every mutable row.
//  - ISOLATION: all models live in the dedicated `bharatcart` Postgres schema (multiSchema),
//    so Prisma never touches the pre-existing tables in `public`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) — used by the app
  directUrl = env("DIRECT_URL") // direct — used by Prisma Migrate
  schemas   = ["bharatcart"]
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  CUSTOMER
  ADMIN

  @@schema("bharatcart")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@schema("bharatcart")
}

enum OrderStatus {
  PENDING // created, awaiting payment (or COD confirmation)
  CONFIRMED // paid & verified (or COD accepted); stock decremented
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED

  @@schema("bharatcart")
}

enum PaymentMode {
  PREPAID // Razorpay
  COD // Cash on Delivery

  @@schema("bharatcart")
}

enum PaymentProvider {
  RAZORPAY
  COD

  @@schema("bharatcart")
}

enum PaymentStatus {
  CREATED // razorpay order created, awaiting capture
  AUTHORIZED
  CAPTURED // money captured — source of truth via webhook
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  COD_PENDING // COD, collected on delivery

  @@schema("bharatcart")
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED

  @@schema("bharatcart")
}

enum CouponType {
  PERCENT // value = basis points (1000 = 10%), maxDiscount caps it
  FLAT // value = paise

  @@schema("bharatcart")
}

// GST rate slabs (basis points). Stored on Product; snapshotted on OrderItem.
enum GstRate {
  ZERO // 0
  FIVE // 500
  TWELVE // 1200
  EIGHTEEN // 1800
  TWENTYEIGHT // 2800

  @@schema("bharatcart")
}

// ============================================================================
// AUTH (Auth.js v5 / NextAuth + Prisma adapter)
//   Credentials login uses a JWT session strategy; Google OAuth persists here.
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // null for OAuth-only users
  image         String?
  phone         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  addresses          Address[]
  cart               Cart?
  wishlist           WishlistItem[]
  orders             Order[]
  reviews            Review[]
  couponRedemptions  CouponRedemption[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]

  @@index([role])
  @@schema("bharatcart")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@schema("bharatcart")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("bharatcart")
}

// Auth.js email-verification (magic-link) table — kept for adapter completeness.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("bharatcart")
}

// Our own email/password flows store HASHED tokens only.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("bharatcart")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("bharatcart")
}

// ============================================================================
// ADDRESSES (Indian format)
// ============================================================================

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String // used for GST place-of-supply
  pincode   String // 6-digit PIN
  country   String   @default("IN")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("bharatcart")
}

// ============================================================================
// CATALOG
// ============================================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@schema("bharatcart")
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())
  products  Product[]

  @@index([slug])
  @@schema("bharatcart")
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String        @db.Text
  status      ProductStatus @default(DRAFT)

  categoryId String
  brandId    String?

  // Denormalized display price = min active-variant price (GST-inclusive, paise).
  // Authoritative price/stock lives on ProductVariant.
  displayPrice Int // paise
  displayMrp   Int // paise, for strikethrough

  hasVariants Boolean @default(false)

  // GST
  hsnCode String?
  gstRate GstRate @default(EIGHTEEN)

  specifications Json? // [{ group, key, value }]

  isFeatured   Boolean @default(false)
  isNewArrival Boolean @default(false)

  // Denormalized review aggregates (recomputed on review write).
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)
  rating1       Int   @default(0)
  rating2       Int   @default(0)
  rating3       Int   @default(0)
  rating4       Int   @default(0)
  rating5       Int   @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Full-text search over title + description. This column is a Postgres
  // GENERATED tsvector (the generated-column DDL is applied in the init
  // migration, which is hand-edited after `prisma migrate diff`). Declared here
  // as Unsupported so Prisma tracks the column and does not report drift; it is
  // queried via $queryRaw, never through the typed client.
  searchVector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id])
  brand    Brand?           @relation(fields: [brandId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]
  wishedBy WishlistItem[]

  // Full-text search vector (title + description + brand) added via raw-SQL
  // migration as a generated column with a GIN index. Not modeled as a field.

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([status, createdAt]) // newest listings
  @@index([status, displayPrice]) // price sort/filter
  @@index([searchVector], type: Gin) // full-text search
  @@schema("bharatcart")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sku       String   @unique
  label     String // e.g. "M / Red" or "Default"
  options   Json? // { "Size": "M", "Color": "Red" }
  price     Int // paise, GST-inclusive
  mrp       Int // paise
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([productId, isActive])
  @@schema("bharatcart")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  variantId String? // optional: image tied to a specific variant (e.g. color)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@schema("bharatcart")
}

// ============================================================================
// CART & WISHLIST
// ============================================================================

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@schema("bharatcart")
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  variantId     String
  quantity      Int      @default(1)
  savedForLater Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@schema("bharatcart")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@schema("bharatcart")
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique // human-facing, e.g. BC-2026-000123
  userId      String
  status      OrderStatus @default(PENDING)
  paymentMode PaymentMode

  // Shipping address SNAPSHOT (addresses can change/delete after ordering)
  shipFullName String
  shipPhone    String
  shipLine1    String
  shipLine2    String?
  shipLandmark String?
  shipCity     String
  shipState    String
  shipPincode  String
  shipCountry  String  @default("IN")

  // Money — all paise, all recomputed server-side from DB
  itemsSubtotal Int // sum of line inclusive prices
  discountTotal Int @default(0)
  shippingTotal Int @default(0)
  codCharge     Int @default(0)
  grandTotal    Int // what the customer pays

  // GST snapshot (derived from inclusive prices)
  taxableTotal  Int       @default(0) // pre-tax value baked into inclusive price
  cgstTotal     Int       @default(0)
  sgstTotal     Int       @default(0)
  igstTotal     Int       @default(0)
  placeOfSupply String? // buyer state code
  sellerGstin   String?
  invoiceNumber String?   @unique
  invoiceDate   DateTime?

  // Coupon snapshot
  couponId   String?
  couponCode String?

  // Payment linkage
  razorpayOrderId String? @unique

  // Fulfilment
  carrier        String?
  trackingNumber String?
  confirmedAt    DateTime?
  packedAt       DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id])
  items      OrderItem[]
  payment    Payment?
  coupon     Coupon?           @relation(fields: [couponId], references: [id])
  redemption CouponRedemption?
  reviews    Review[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@schema("bharatcart")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String? // nullable if variant later deleted
  productId String?

  // Snapshots (never trust live product data for a placed order)
  productTitle String
  variantLabel String
  sku          String
  imageUrl     String?
  unitPrice    Int // paise, GST-inclusive, at time of order
  mrp          Int
  quantity     Int
  lineSubtotal Int // unitPrice * quantity

  // GST snapshot per line
  hsnCode      String?
  gstRate      GstRate
  taxableValue Int     @default(0)
  cgst         Int     @default(0)
  sgst         Int     @default(0)
  igst         Int     @default(0)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@schema("bharatcart")
}

// ============================================================================
// PAYMENTS (Razorpay) — webhook is source of truth; idempotent
// ============================================================================

model Payment {
  id                String          @id @default(cuid())
  orderId           String          @unique
  provider          PaymentProvider
  status            PaymentStatus   @default(CREATED)
  amount            Int // paise
  currency          String          @default("INR")
  razorpayOrderId   String?
  razorpayPaymentId String?         @unique
  razorpaySignature String? // verified HMAC, stored for audit
  method            String? // upi / card / netbanking / wallet (from Razorpay)
  capturedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([razorpayPaymentId])
  @@schema("bharatcart")
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  razorpayRefundId String?      @unique
  amount           Int // paise
  status           RefundStatus @default(PENDING)
  reason           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@schema("bharatcart")
}

// Razorpay webhook idempotency: one row per delivered event id.
model WebhookEvent {
  id          String    @id // Razorpay's x-razorpay-event-id
  event       String // payment.captured, payment.failed, refund.processed
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([event])
  @@schema("bharatcart")
}

// ============================================================================
// COUPONS
// ============================================================================

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  description   String?
  type          CouponType
  value         Int // PERCENT: basis points; FLAT: paise
  minOrderValue Int        @default(0) // paise
  maxDiscount   Int? // paise, caps PERCENT coupons
  usageLimit    Int? // global cap on redemptions
  perUserLimit  Int? // per-user cap
  usedCount     Int        @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([code])
  @@index([isActive])
  @@schema("bharatcart")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  amount    Int // discount applied, paise
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, orderId])
  @@index([couponId])
  @@index([userId])
  @@schema("bharatcart")
}

// ============================================================================
// REVIEWS — verified-purchase enforced server-side
// ============================================================================

model Review {
  id                 String   @id @default(cuid())
  userId             String
  productId          String
  orderId            String // the DELIVERED order proving purchase
  rating             Int // 1..5 (validated in app)
  title              String?
  body               String   @db.Text
  images             String[] // Cloudinary URLs
  isVerifiedPurchase Boolean  @default(true)
  isHidden           Boolean  @default(false) // admin moderation
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // one review per user per product
  @@index([productId])
  @@index([productId, isHidden])
  @@schema("bharatcart")
}
